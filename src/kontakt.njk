---
title: "Kontakt | Németová — Kosmetika Sothys Paris"
description: "Objednejte se na kosmetické ošetření, manikúru nebo pedikúru. Salon Petry Németové v budově Kostky Pb v Příbrami."
heroImage: true
---
<section class="page-hero page-hero--image">
  <div class="page-hero__media">
    <img src="assets/img/hero-kontakt.webp" alt="Petra Németová" loading="eager">
  </div>
  <div class="wrap page-hero__inner">
    <span class="eyebrow">Kontakt</span>
    <h1>Domluvme si termín</h1>
  </div>
</section>

<section class="section">
  <div class="wrap grid-2" style="align-items: start;">
    <div data-reveal>
      <span class="eyebrow">Napište mi</span>
      <h2>Kontaktní formulář</h2>
      <form class="contact-form" id="contactForm">
        <input type="hidden" name="subject" value="Nová zpráva z webu — nemetova.cz">
        <input type="hidden" name="from_name" value="Németová — web">
        <input type="checkbox" name="botcheck" class="hp-field" tabindex="-1" autocomplete="off" aria-hidden="true">
        <div class="form-row">
          <div class="form-group">
            <label for="name">Jméno a příjmení</label>
            <input type="text" id="name" name="name" required autocomplete="name">
          </div>
          <div class="form-group">
            <label for="email">E-mail</label>
            <input type="email" id="email" name="email" required autocomplete="email">
          </div>
        </div>
        <div class="form-row">
          <div class="form-group">
            <label for="phone">Telefon (nepovinné)</label>
            <input type="tel" id="phone" name="phone" autocomplete="tel">
          </div>
          <div class="form-group">
            <label for="service">Mám zájem o</label>
            <select id="service" name="service">
              <option value="Kosmetické ošetření Sothys">Kosmetické ošetření Sothys</option>
              <option value="Manikúra">Manikúra</option>
              <option value="Pedikúra">Pedikúra</option>
              <option value="Dárkový poukaz">Dárkový poukaz</option>
              <option value="Nevím, poraďte mi">Nevím, poraďte mi</option>
            </select>
          </div>
        </div>
        <div class="form-group">
          <label for="message">Zpráva</label>
          <textarea id="message" name="message" rows="5" required placeholder="Napište mi, o jakou péči máte zájem a v jakém termínu…"></textarea>
        </div>
        <div class="form-gdpr-checkbox">
          <input type="checkbox" id="gdpr" name="gdpr" required>
          <label for="gdpr">Souhlasím se zpracováním osobních údajů dle <a href="gdpr.html" target="_blank" rel="noopener">Zásad ochrany osobních údajů</a>.</label>
        </div>
        <button type="submit" class="btn btn--solid">Odeslat zprávu</button>
      </form>
    </div>

    <div data-reveal>
      <span class="eyebrow">Přímý kontakt</span>
      <h2>Kde mě najdete</h2>
      <ul class="contact-info-list">
        <li><span class="label">Telefon</span><a href="tel:{{ site.phoneHref }}">{{ site.phone }}</a></li>
        <li><span class="label">E-mail</span><a href="mailto:{{ site.email }}">{{ site.email }}</a></li>
        <li><span class="label">Adresa</span>{{ site.address }}</li>
        <li><span class="label">IČO</span>{{ site.ico }}</li>
      </ul>
      <div class="social-row">
        <a href="{{ site.instagram }}" target="_blank" rel="noopener" aria-label="Instagram">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.4" cy="6.6" r="1"/></svg>
        </a>
        <a href="{{ site.facebook }}" target="_blank" rel="noopener" aria-label="Facebook">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M14 9h3V5h-3a4 4 0 0 0-4 4v2H7v4h3v6h4v-6h3l1-4h-4v-2a1 1 0 0 1 1-1z"/></svg>
        </a>
      </div>
      <div class="rule"></div>
      <div class="map-frame">
        <iframe src="https://www.google.com/maps?q=Kostka+Pb%2C+P%C5%99%C3%ADbram&output=embed" title="Mapa — Kostka Pb, Příbram" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
      </div>
    </div>
  </div>
</section>
